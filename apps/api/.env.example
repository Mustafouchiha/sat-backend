# ───────── Neon (PostgreSQL) ─────────
# Neon Console → Connection Details. DATABASE_URL — "Pooled connection" (host ichida -pooler bor),
# DIRECT_URL — oddiy (direct) ulanish: migratsiyalar uchun.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/sat?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/sat?sslmode=require

# ───────── Xavfsizlik ─────────
# Kamida 32 belgili tasodifiy satr: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ───────── Telegram bot (@BotFather) ─────────
BOT_TOKEN=123456789:AA...
BOT_USERNAME=your_sat_bot
# webhook (Railway public domen bo'lsa avtomatik), polling (lokal) yoki off
# BOT_MODE=webhook
# Webhook so'rovlarini tekshirish uchun tasodifiy satr (faqat A-Z, a-z, 0-9, _ -)
WEBHOOK_SECRET=change-me-random-secret
# Railway avtomatik RAILWAY_PUBLIC_DOMAIN beradi; boshqa hostingda qo'lda:
# PUBLIC_URL=https://sat-api.up.railway.app

# ───────── Mini App (Vercel) ─────────
MINI_APP_URL=https://your-sat-app.vercel.app
# Qo'shimcha ruxsat etilgan originlar (vergul bilan)
# CORS_ORIGINS=https://admin.example.uz

# Bu Telegram ID'lar avtomatik SUPER_ADMIN bo'ladi (vergul bilan). ID ni @userinfobot dan bilish mumkin.
SUPER_ADMIN_TG_IDS=123456789

# ───────── Ixtiyoriy ─────────
# Claude AI yordamchi (savoldan shablon taklifi). Bo'lmasa — tugma 501 qaytaradi.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# Desmos grafik kalkulyator kaliti (bo'lmasa oddiy ilmiy kalkulyator)
# DESMOS_API_KEY=
# Cron (kunlik test, eslatmalar, hisobotlar). Bir nechta replika bo'lsa faqat bittasida true qoldiring.
CRON_ENABLED=true
NODE_ENV=production
# PORT — Railway o'zi beradi

# Faqat lokal ishlab chiqish: Telegram'siz kirish (/api/auth/dev). Productionda HECH QACHON yoqmang.
# ALLOW_DEV_LOGIN=true
