{
  "name": "@sat/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SAT Mini App backend: Express + Prisma (Neon) + telegraf bot + Socket.IO (Railway)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsup",
    "start": "prisma migrate deploy && node dist/index.js",
    "start:only": "node dist/index.js",
    "typecheck": "tsc -p .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "@prisma/client": "^6.3.0",
    "@sat/generator": "*",
    "@sat/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mathjs": "^14.0.1",
    "node-cron": "^3.0.3",
    "prisma": "^6.3.0",
    "socket.io": "^4.8.1",
    "telegraf": "^4.16.3",
    "tsup": "^8.3.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node-cron": "^3.0.11"
  }
}
